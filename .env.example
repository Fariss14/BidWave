# Copy to .env for local development. No email verification is required.
DATABASE_PATH=data/bidwave.sqlite
# Set NODE_ENV=production and APP_ORIGIN to the exact HTTPS origin for deployment.
# APP_ORIGIN=https://bidwave.example.com
# HOST=127.0.0.1
# PORT=3000

# Sellers configure receiving accounts and QR images in Dashboard → Seller contact & payments.
# No map API key, email provider, or site-wide payment destination is needed.

# Hosted deployment (server only): PostgreSQL + private Supabase Storage.
# DATABASE_URL=postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=BACKEND_SECRET_KEY
# SUPABASE_STORAGE_BUCKET=bidwave-private
# DATABASE_CA_CERT=OPTIONAL_DATABASE_CA_PEM
